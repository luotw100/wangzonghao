# Per-instance env file. Copy to .env.<instance> (e.g. .env.release, .env.debug),
# fill in, then run e.g.:
#   docker compose --env-file .env.release --profile storage --profile app --profile edge up -d
#
# Each instance file is fully self-contained (there is no shared base .env).
# COMPOSE_PROJECT_NAME isolates instances — separate containers, volumes and
# network — so no `-p` flag is needed.

# --- Instance identity ---
COMPOSE_PROJECT_NAME=release
# Optional: default profiles for this instance, so you can omit --profile on the
# CLI. A --profile flag on the command line overrides this.
COMPOSE_PROFILES=storage,app,edge

# --- PostgreSQL (single instance, three schemas: auth / studio / chat) ---
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=laborster

# Built from the three above. Schemas are created on first migrate.
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@db:5432/laborster

# --- MinIO (root creds also used as S3 access key by the app) ---
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET=media
UPLOAD_MAX_SIZE_MB=50

# --- S3 public URL ---
# Consumed by the API (app profile); the API process REQUIRES it at boot.
# It is baked into presigned URLs handed to the browser.
#   * With the edge profile up: set to the public https host Caddy serves
#     (must match the Caddyfile site address and minio's MINIO_SERVER_URL).
#   * With no edge: point at minio directly (http://localhost:9000), or a
#     throwaway like http://unused.local if you never exercise uploads.
S3_PUBLIC_URL=https://s3.yourdomain.com

# --- Edge (only consumed when the `edge` profile is running) ---
CF_TUNNEL_TOKEN=CHANGE_ME
CF_API_TOKEN=CHANGE_ME (Cloudflare token: Zone:DNS:Edit + Zone:Zone:Read; Caddy DNS-01)
FRP_SERVER_ADDR=CHANGE_ME (frp relay public IP, e.g. a Seoul VPS)
FRP_TOKEN=CHANGE_ME (must match the relay's frps token)
