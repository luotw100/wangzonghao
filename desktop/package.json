{
  "name": "laborster-desktop",
  "private": true,
  "version": "0.1.2",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n RENDERER,ELECTRON -c blue,magenta \"vite\" \"npm run dev:app\"",
    "dev:app": "wait-on tcp:127.0.0.1:5273 && VITE_DEV_SERVER_URL=http://localhost:5273 electron .",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.7.2",
    "vite": "^8.0.8",
    "wait-on": "^8.0.1"
  }
}
