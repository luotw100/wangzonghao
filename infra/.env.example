# Single .env for the whole stack — copy to infra/.env and fill in.

# --- PostgreSQL (single instance, three schemas: auth / studio / chat) ---
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=laborster

# Built from the three above. Schemas are created on first migrate.
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@db:5432/laborster

# --- MinIO + S3 (single bucket; chat keys carry their own "media/" prefix) ---
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=media

UPLOAD_MAX_SIZE_MB=50
