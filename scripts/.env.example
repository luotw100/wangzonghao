# scripts/seed_dev.py environment — copy to scripts/.env and fill in every value.
# All keys are REQUIRED. Nothing is defaulted or skipped by the script.

# Service URLs.
CHAT_URL=http://localhost:23456
STUDIO_URL=http://localhost:23457

# Studio admin (used only to create the shared Provider).
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=CHANGE_ME
SEED_ADMIN_DISPLAY=平台管理员

# User lists: comma-separated, each item EXACTLY `username:password:display`.
# The two lists are independent — if you want the same accounts on both
# sides, write the same entries in both.
CHAT_SEED_USERS=test1:Test123!:测试一,test2:Test123!:测试二
STUDIO_SEED_USERS=test1:Test123!:测试一,test2:Test123!:测试二

# Shared Studio Provider (admin auth).
PROVIDER_NAME=dev-deepseek
PROVIDER_BASE_URL=https://api.deepseek.com
PROVIDER_MODEL=deepseek-v4-flash
PROVIDER_API_KEY=CHANGE_ME
